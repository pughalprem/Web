### 5\. Login page with JavaScript validation

File: `validate.html`

```html
<!DOCTYPE html>
<html>
<head><title>Login Validation</title></head>
<body>
<h2>User Login</h2>

<form onsubmit="return validate()">
    Username: <input type="text" id="user"><br><br>
    Password: <input type="password" id="pass"><br><br>
    <input type="submit" value="Login">
</form>

<p id="msg"></p>

<script>
function validate() {
    var u = document.getElementById("user").value;
    var p = document.getElementById("pass").value;

    if (u == "" || p == "") {
        document.getElementById("msg").innerHTML =
            "Enter username and password";
        return false;
    }

    if (u == "admin" && p == "1234") {
        document.getElementById("msg").innerHTML =
            "Login successful";
        return false;
    }

    document.getElementById("msg").innerHTML =
        "Invalid username or password";
    return false;
}
</script>
</body>
</html>
```

This is a demonstration of client-side validation, not secure authentication.

